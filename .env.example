# Copia este archivo a .env y ajusta los valores.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Base de datos (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://tickets:tickets@localhost:5432/tickets

# ---------------------------------------------------------------------------
# Seguridad JWT (cambia SECRET_KEY en producción)
# ---------------------------------------------------------------------------
SECRET_KEY=dev-secret-change-me
# REFRESH_SECRET_KEY=otra-clave-distinta
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Cookies y CORS
# ---------------------------------------------------------------------------
# REFRESH_COOKIE_SECURE=true   # obligatorio si sirves la API por HTTPS
# REFRESH_COOKIE_SAMESITE=lax
# CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# OAuth2 (opcional)
# ---------------------------------------------------------------------------
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAUTH_CALLBACK_BASE_URL=http://127.0.0.1:8000
# OAUTH_FRONTEND_REDIRECT=/
